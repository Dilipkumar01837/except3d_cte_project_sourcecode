# Application
NODE_ENV=development
APP_NAME=Code to Escape
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Server
# 3000 is canonical: docker-compose and the e2e suite both expect it.
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Reverse-proxy hops to trust for req.ip. Use 0 when nothing sits in front of
# the API, 1 when a single nginx does. Trusting more lets clients spoof
# X-Forwarded-For and evade IP rate limits.
TRUST_PROXY_HOPS=1

# Database
DATABASE_URL=postgresql://cte:cte_dev_password@localhost:5432/code_to_escape

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Day 2)
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-secret-in-production
REFRESH_TOKEN_EXPIRES_IN=30d

# OAuth (Day 2) — fill in from provider dashboards
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# AI hints (optional; authored hints remain available when unset)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Consent-gated engagement telemetry (opt-in, off by default)
# Raw events are pruned after TELEMETRY_RETENTION_DAYS; a single client batch is
# capped at TELEMETRY_MAX_BATCH. The worker sweeps every TELEMETRY_SWEEP_INTERVAL_MS.
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_MAX_BATCH=50
TELEMETRY_SWEEP_INTERVAL_MS=21600000

# Isolated Code Runner (required by the worker; never expose this service publicly)
CODE_RUNNER_URL=http://localhost:3002
CODE_RUNNER_TOKEN=code-to-escape-dev-runner-token
# Override the sandbox Docker image tag if you build a custom one
CODE_RUNNER_IMAGE=code-to-escape/sandbox:latest
# Note: per-challenge time and memory limits are passed by the server at request time.
# CPU allocation (--cpus 0.5) is hardcoded in apps/code-runner/src/sandbox.ts.

# E2E tests — set these to run admin dashboard E2E tests
# These must be credentials for an ADMIN or SUPER_ADMIN account in your dev DB
ADMIN_E2E_EMAIL=
ADMIN_E2E_PASSWORD=
