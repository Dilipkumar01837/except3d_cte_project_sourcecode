# Application
NODE_ENV=development
APP_NAME=Code to Escape
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Database
DATABASE_URL=postgresql://cte:cte_dev_password@localhost:5432/code_to_escape

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Day 2)
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-secret-in-production
REFRESH_TOKEN_EXPIRES_IN=30d

# OAuth (Day 2) — fill in from provider dashboards
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI (Future)
GEMINI_API_KEY=

# Code Runner (Future)
CODE_RUNNER_IMAGE=code-to-escape/runner:latest
CODE_RUNNER_TIMEOUT_MS=5000
CODE_RUNNER_MEMORY_MB=128
CODE_RUNNER_CPU_LIMIT=0.5
