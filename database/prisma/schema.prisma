// No explicit `output`: the client must be generated into the @prisma/client
// package that consumers actually resolve. A hardcoded path writes to
// database/node_modules/.prisma, which pnpm's isolated store never exposes to
// apps/server, leaving the server typechecked against a stale client.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
}

enum UserRole {
  PLAYER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum PlayerRank {
  BEGINNER
  NOVICE
  APPRENTICE
  JOURNEYMAN
  EXPERT
  MASTER
  GRANDMASTER
}

enum World {
  PYTHON_FOREST
  JAVASCRIPT_JUNGLE
  TYPESCRIPT_TUNDRA
  RUST_REALM
  GO_GALAXY
}

// ─────────────────────────────────────────
// User
// ─────────────────────────────────────────

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  username          String   @unique
  passwordHash      String?
  emailVerified     Boolean  @default(false)
  emailVerifyToken  String?
  resetPasswordToken String?
  resetPasswordExpiry DateTime?
  authProvider      AuthProvider @default(EMAIL)
  oauthId           String?
  avatarUrl         String?
  isActive          Boolean  @default(true)
  role              UserRole @default(PLAYER)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  profile        Profile?
  sessions       Session[]
  refreshTokens  RefreshToken[]
  loginHistory   LoginHistory[]
  achievements   PlayerAchievement[]
  inventory      PlayerInventory[]
  worldProgress  PlayerWorldProgress[]
  levelProgress  PlayerLevelProgress[]
  dailyRewards   PlayerDailyReward[]
  notifications  PlayerNotification[]
  submissions    Submission[]
  hintReveals    PlayerHintReveal[]
  createdDuels   DuelMatch[] @relation("DuelCreator")
  joinedDuels    DuelMatch[] @relation("DuelOpponent")
  wonDuels       DuelMatch[] @relation("DuelWinner")
  aiHintHistory  AiHintHistory[]
  learningProfile UserLearningProfile?
  hintHistory    HintHistory[]
  roomKeys       PlayerRoomKey[]
  telemetryEvents TelemetryEvent[]
  userEvents      UserEvent[]
  userConsent     UserConsent?
  assessmentAttempts AssessmentAttempt[]
  experimentAssignments ExperimentAssignment[]
  sceneStates      PlayerSceneState[]
  sentFriendRequests FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")
  friendshipA Friendship[] @relation("FriendshipA")
  friendshipB Friendship[] @relation("FriendshipB")
  blockedUsers BlockedUser[] @relation("Blocker")
  blockedBy BlockedUser[] @relation("Blocked")
  sentMessages Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageRecipient")
  activities ActivityFeed[]
  rating PlayerRating?
  matchHistory MatchHistory[] @relation("MatchPlayer")
  fcmTokens UserFcmToken[]

  @@index([email])
  @@index([username])
  @@index([oauthId])
}

// ─────────────────────────────────────────
// Profile (game state)
// ─────────────────────────────────────────

model Profile {
  id            String     @id @default(uuid())
  userId        String     @unique
  displayName   String
  bio           String?
  level         Int        @default(1)
  xp            Int        @default(0)
  coins         Int        @default(100)
  rank          PlayerRank @default(BEGINNER)
  currentWorld  World      @default(PYTHON_FOREST)
  codingStreak  Int        @default(0)
  lastStreakDate DateTime?
  inventory     Json       @default("[]")
  achievements  Json       @default("[]")
  stats         Json       @default("{}")
  country       String?
  favoriteLanguage String?
  programmingInterests String[] @default([])
  energy        Int        @default(10)
  lives         Int        @default(3)
  completedChallenges Int @default(0)
  accuracy      Float      @default(0)
  gamesPlayed   Int        @default(0)
  longestStreak Int        @default(0)
  // Consent-gated engagement telemetry. Off by default; nothing is recorded
  // until the player explicitly opts in. The timestamp and policy version make
  // consent auditable.
  telemetryOptIn        Boolean   @default(false)
  telemetryConsentAt    DateTime?
  telemetryConsentVersion String?
  friendsVisible Boolean @default(true)
  activityVisible Boolean @default(true)
  messagePolicy String @default("FRIENDS")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────
// Session
// ─────────────────────────────────────────

model Session {
  id         String   @id @default(uuid())
  userId     String
  ipAddress  String?
  userAgent  String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────
// RefreshToken
// ─────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  family    String   // token rotation family ID
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([family])
  @@index([expiresAt, isRevoked])
}

// ─────────────────────────────────────────
// LoginHistory
// ─────────────────────────────────────────

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  provider  AuthProvider
  success   Boolean
  failReason String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AchievementCategory {
  CODING
  EXPLORATION
  SPEED
  ACCURACY
  STREAK
  COLLECTION
}

enum NotificationType {
  ACHIEVEMENT_UNLOCKED
  LEVEL_COMPLETED
  DAILY_REWARD
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  CHAT_MESSAGE
  MATCH_FOUND
  SYSTEM
}

enum ProgrammingLanguage {
  PYTHON
  JAVA
  JAVASCRIPT
  TYPESCRIPT
  CPP
  GO
  RUST
}

enum ChallengeDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ChallengeType {
  ALGORITHMS
  DATA_STRUCTURES
  DEBUGGING
  OUTPUT_PREDICTION
  FILL_IN_THE_BLANK
  CODE_COMPLETION
}

enum HintType {
  CONCEPTUAL
  DIRECTIONAL
  SPECIFIC
  EXAMPLE
  DEBUGGING
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  INTERNAL_ERROR
}

enum DuelStatus {
  OPEN
  ACTIVE
  COMPLETED
  CANCELLED
}

model GameWorld {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  difficulty  Int      @default(1)
  requiredXp  Int      @default(0)
  estimatedMinutes Int @default(30)
  imageUrl    String?
  sortOrder   Int      @unique
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  levels     GameLevel[]
  progress   PlayerWorldProgress[]
  assessments Assessment[]
  roomKeys   RoomKey[]
  roomLocks  RoomLock[]
}

// ─────────────────────────────────────────────────────────────────
// Escape room (locks and keys)
// ─────────────────────────────────────────────────────────────────

/// An item a player collects by completing a level, which opens a lock.
///
/// `grantedByLevelId` is what makes this an escape-room mechanic rather than a
/// badge: the key is awarded when that level is solved, so the unlock is a
/// consequence of playing rather than something a client can assert.
model RoomKey {
  id          String   @id @default(uuid())
  worldId     String
  slug        String   @unique
  title       String
  description String
  artKey      String?
  /// Completing this level awards the key. Unique so two levels cannot grant
  /// the same key, which would make the award ambiguous.
  grantedByLevelId String?  @unique
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  world       GameWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)
  grantedByLevel GameLevel? @relation("grantedRoomKey", fields: [grantedByLevelId], references: [id], onDelete: SetNull)
  unlocks     RoomLock[]
  holders     PlayerRoomKey[]

  @@index([worldId, isPublished])
}

/// A door in front of a level. The level is reachable when the player either
/// completes the preceding level or holds the key this lock requires.
model RoomLock {
  id          String   @id @default(uuid())
  worldId     String
  /// The level this lock guards. One lock per level.
  levelId     String   @unique
  title       String
  prompt      String
  /// When set, the player must hold this key for the lock to be open.
  requiresKeyId String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  world       GameWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)
  level       GameLevel @relation("guardedRoomLock", fields: [levelId], references: [id], onDelete: Cascade)
  requiresKey RoomKey?  @relation(fields: [requiresKeyId], references: [id], onDelete: SetNull)

  @@unique([worldId, levelId])
  @@index([requiresKeyId])
}

/// A key a player holds. Written by the worker when the granting level is solved.
model PlayerRoomKey {
  id         String   @id @default(uuid())
  userId     String
  keyId      String
  acquiredAt DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key RoomKey  @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@unique([userId, keyId])
  @@index([userId])
}

model GameLevel {
  id          String   @id @default(uuid())
  worldId     String
  number      Int
  title       String
  description String
  difficulty  Int      @default(1)
  xpReward    Int      @default(50)
  previewUrl  String?
  challengeId String?  @unique
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  world       GameWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)
  challenge   Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  progress    PlayerLevelProgress[]
  /// The key this level awards, if any. `grantedByLevelId` on RoomKey owns the
  /// foreign key; this is the inverse side.
  grantsRoomKey RoomKey? @relation("grantedRoomKey")
  /// The lock guarding this level, if any. `levelId` on RoomLock owns the foreign
  /// key; this is the inverse side.
  guardedByRoomLock RoomLock? @relation("guardedRoomLock")
  assessments Assessment[]
  sceneDefinition SceneDefinition?
  sceneStates PlayerSceneState[]
  @@unique([worldId, number])
  @@index([worldId, isPublished])
}

model PlayerWorldProgress {
  id          String   @id @default(uuid())
  userId      String
  worldId     String
  isUnlocked  Boolean  @default(false)
  completionPercent Int @default(0)
  lastPlayedAt DateTime?
  completedAt DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  world       GameWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)
  @@unique([userId, worldId])
  @@index([userId, isUnlocked])
}

model PlayerLevelProgress {
  id          String   @id @default(uuid())
  userId      String
  levelId     String
  isCompleted Boolean  @default(false)
  clueRead    Boolean  @default(false)
  stars       Int      @default(0)
  attempts    Int      @default(0)
  bestTimeSeconds Int?
  completedAt DateTime?
  lastPlayedAt DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       GameLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  @@unique([userId, levelId])
  @@index([userId, isCompleted])
}

model Achievement {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  category    AchievementCategory
  iconUrl     String?
  target      Int      @default(1)
  xpReward    Int      @default(0)
  isHidden    Boolean  @default(false)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  players     PlayerAchievement[]
}

model PlayerAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  progress      Int      @default(0)
  unlockedAt    DateTime?

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

model InventoryItem {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  category    String
  rarity      String   @default("COMMON")
  iconUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  players     PlayerInventory[]
}

model PlayerInventory {
  id        String   @id @default(uuid())
  userId    String
  itemId    String
  quantity  Int      @default(1)
  acquiredAt DateTime @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@unique([userId, itemId])
}

model DailyReward {
  id          String   @id @default(uuid())
  day         Int      @unique
  xpAmount    Int      @default(0)
  coinAmount  Int      @default(0)
  itemId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  claims      PlayerDailyReward[]
}

model PlayerDailyReward {
  id        String   @id @default(uuid())
  userId    String
  rewardId  String
  claimedAt DateTime @default(now())
  // UTC midnight of the day the reward was claimed. The unique constraint on
  // (userId, claimDate) is the authoritative one-claim-per-day guard: the
  // in-transaction findFirst check below cannot see an uncommitted concurrent
  // insert under READ COMMITTED, so without this a double-click or two tabs
  // paid the XP and coins twice.
  claimDate DateTime
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward    DailyReward @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  @@unique([userId, claimDate])
  @@index([userId, claimedAt])
}

model PlayerNotification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model Challenge {
  id              String              @id @default(uuid())
  slug            String              @unique
  title           String
  statement       String
  constraints     String?
  starterCode     Json                @default("{}")
  difficulty      ChallengeDifficulty
  type            ChallengeType
  tags            String[]            @default([])
  supportedLanguages ProgrammingLanguage[]
  xpReward        Int                 @default(50)
  timeLimitMs     Int                 @default(2000)
  memoryLimitMb   Int                 @default(128)
  isPublished     Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  testCases       ChallengeTestCase[]
  solutions       ChallengeSolution[]
  hints           ChallengeHint[]
  submissions     Submission[]
  gameLevel       GameLevel?
  duels           DuelMatch[]
  aiHintHistory   AiHintHistory[]
  hintHistory     HintHistory[]
  @@index([isPublished, difficulty])
  @@index([type])
}

model DuelMatch {
  id          String     @id @default(uuid())
  challengeId String
  creatorId   String
  opponentId  String?
  winnerId    String?
  status      DuelStatus @default(OPEN)
  createdAt   DateTime   @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  creator   User      @relation("DuelCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  opponent  User?     @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: SetNull)
  winner    User?     @relation("DuelWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  submissions Submission[] @relation("DuelSubmission")

  @@index([status, createdAt])
  @@index([creatorId, createdAt])
  @@index([opponentId, createdAt])
  @@index([winnerId])
}

model AiHintHistory {
  id          String   @id @default(uuid())
  userId      String
  challengeId String
  language    ProgrammingLanguage
  hint        String
  createdAt   DateTime @default(now())
  // Engagement-only outcome signals (no learning-outcome claim): whether the
  // player went on to get an accepted submission for this challenge after the
  // hint, and an optional self-reported "was this helpful?".
  resolvedAfter Boolean  @default(false)
  resolvedAt    DateTime?
  helpful       Boolean?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([challengeId, createdAt])
}

model UserLearningProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  skillLevels            Json     @default("{}")
  errorPatterns          Json     @default("{}")
  preferredLearningStyle String?
  personalizedHintsOptOut Boolean  @default(false)
  currentStreak          Int      @default(0)
  xp                     Int      @default(0)
  level                  Int      @default(1)
  recentPerformanceTrend Float?
  totalRuns              Int      @default(0)
  successfulRuns         Int      @default(0)
  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hintHistory            HintHistory[]
  @@index([updatedAt])
}

model HintHistory {
  id               String               @id @default(uuid())
  userId           String
  challengeId      String
  language         ProgrammingLanguage
  hintType         HintType
  hintText         String
  contextSnapshot  Json
  helpfulRating    Boolean?
  attemptsBefore   Int                  @default(0)
  attemptsAfter    Int?
  solvedAfter      Boolean              @default(false)
  requestedAnother Boolean              @default(false)
  createdAt        DateTime             @default(now())
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade, map: "HintHistory_user_fkey")
  challenge        Challenge            @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  profile          UserLearningProfile  @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "HintHistory_profile_fkey")
  @@index([userId, createdAt])
  @@index([challengeId, createdAt])
  @@index([hintType, helpfulRating])
}

model ChallengeTestCase {
  id          String    @id @default(uuid())
  challengeId String
  input       String
  expectedOutput String
  explanation String?
  isHidden    Boolean   @default(false)
  weight      Int       @default(1)
  sortOrder   Int       @default(0)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  @@index([challengeId, isHidden])
}

model ChallengeSolution {
  id          String              @id @default(uuid())
  challengeId String
  language    ProgrammingLanguage
  code        String
  explanation String?
  challenge   Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  @@unique([challengeId, language])
}

model ChallengeHint {
  id          String    @id @default(uuid())
  challengeId String
  level       Int
  content     String
  xpPenalty   Int       @default(0)
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  reveals     PlayerHintReveal[]
  @@unique([challengeId, level])
}

model PlayerHintReveal {
  id         String        @id @default(uuid())
  userId     String
  hintId     String
  revealedAt DateTime      @default(now())
  // Same engagement-only outcome signals as AiHintHistory.
  resolvedAfter Boolean  @default(false)
  resolvedAt    DateTime?
  helpful       Boolean?
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  hint       ChallengeHint @relation(fields: [hintId], references: [id], onDelete: Cascade)
  @@unique([userId, hintId])
  @@index([userId, revealedAt])
}

model Submission {
  id          String              @id @default(uuid())
  userId      String
  challengeId String
  language    ProgrammingLanguage
  sourceCode  String
  status      SubmissionStatus    @default(QUEUED)
  score       Int                 @default(0)
  executionTimeMs Int?
  memoryUsedKb Int?
  compilerOutput String?
  runtimeOutput String?
  createdAt   DateTime            @default(now())
  completedAt DateTime?
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  results     SubmissionTestResult[]
  duelId      String?
  duel        DuelMatch?            @relation("DuelSubmission", fields: [duelId], references: [id], onDelete: SetNull)
  @@index([userId, challengeId, createdAt])
  @@index([status, createdAt])
  @@index([duelId, userId, createdAt])
}

model SubmissionTestResult {
  id          String    @id @default(uuid())
  submissionId String
  testCaseId  String
  passed      Boolean
  executionTimeMs Int?
  memoryUsedKb Int?
  output      String?
  submission  Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  @@unique([submissionId, testCaseId])
}

// ─────────────────────────────────────────
// Admin Audit Log
// ─────────────────────────────────────────

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminId     String
  action      String   // e.g. "USER_ROLE_UPDATED", "CHALLENGE_PUBLISHED"
  targetType  String?  // e.g. "User", "Challenge"
  targetId    String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

enum AssessmentType {
  PRE
  POST
}

model Assessment {
  id          String         @id @default(uuid())
  worldId     String?
  levelId     String?
  type        AssessmentType
  title       String
  description String?
  isPublished Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  world    GameWorld? @relation(fields: [worldId], references: [id], onDelete: Cascade)
  level    GameLevel? @relation(fields: [levelId], references: [id], onDelete: Cascade)
  questions AssessmentQuestion[]
  attempts AssessmentAttempt[]

  @@index([worldId, type, isPublished])
  @@index([levelId, type, isPublished])
}

model AssessmentQuestion {
  id           String   @id @default(uuid())
  assessmentId String
  kind         String
  prompt       String
  options      Json?
  answer       Json
  points       Int      @default(1)
  objective    String?
  sortOrder    Int      @default(0)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  @@index([assessmentId, sortOrder])
}

model AssessmentAttempt {
  id           String   @id @default(uuid())
  assessmentId String
  userId       String
  score        Int
  maxScore     Int
  timeTakenMs  Int
  attemptNumber Int
  responses    Json
  startedAt    DateTime @default(now())
  completedAt  DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, assessmentId, completedAt])
  @@index([assessmentId, completedAt])
}

model Experiment {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  variants    Json
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments ExperimentAssignment[]
  @@index([isActive, createdAt])
}

model ExperimentAssignment {
  id           String   @id @default(uuid())
  experimentId String
  userId       String
  variant      String
  assignedAt   DateTime @default(now())
  metadata     Json?

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([experimentId, userId])
  @@index([experimentId, variant, assignedAt])
  @@index([userId, assignedAt])
}

model UserEvent {
  id        String   @id @default(uuid())
  userId    String
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model UserConsent {
  id          String   @id @default(uuid())
  userId      String   @unique
  telemetry   Boolean  @default(false)
  consentAt   DateTime?
  withdrawnAt DateTime?
  version     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([telemetry, consentAt])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  userA User @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)
  @@unique([userAId, userBId])
  @@index([userAId, createdAt])
  @@index([userBId, createdAt])
}

model FriendRequest {
  id         String @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  sender User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  @@unique([senderId, receiverId])
  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
}

model BlockedUser {
  id        String @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Message {
  id          String @id @default(uuid())
  senderId    String
  recipientId String
  body        String
  createdAt   DateTime @default(now())
  readAt      DateTime?
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
}

model ActivityFeed {
  id        String @id @default(uuid())
  userId    String
  eventType String
  payload   Json?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model PlayerRating {
  id        String @id @default(uuid())
  userId    String @unique
  rating    Int @default(1000)
  wins      Int @default(0)
  losses    Int @default(0)
  season    String @default("2026-S1")
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([season, rating])
}

model MatchHistory {
  id         String @id @default(uuid())
  duelId     String?
  userId     String
  opponentId String
  result     String
  ratingBefore Int
  ratingAfter Int
  createdAt DateTime @default(now())
  user User @relation("MatchPlayer", fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([opponentId, createdAt])
}

model UserFcmToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  deviceInfo String?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, enabled, lastUsedAt])
}

model SceneDefinition {
  id          String   @id @default(uuid())
  levelId     String   @unique
  modelUrl    String?
  objects     Json
  settings    Json?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  level GameLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  @@index([isPublished, updatedAt])
}

model PlayerSceneState {
  id              String   @id @default(uuid())
  userId          String
  levelId         String
  playerPosition  Json
  unlockedObjects Json
  sceneProgress   Json
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  level GameLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  @@unique([userId, levelId])
  @@index([userId, updatedAt])
  @@index([levelId, updatedAt])
}

// ─────────────────────────────────────────
// Consent-gated engagement telemetry
// ─────────────────────────────────────────

model TelemetryEvent {
  id        String   @id @default(uuid())
  userId    String
  name      String
  payload   Json?
  sessionId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([name, createdAt])
}
