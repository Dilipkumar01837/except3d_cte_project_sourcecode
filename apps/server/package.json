{
  "name": "@code-to-escape/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "seed:beginner": "tsx scripts/seed-beginner-challenges.ts",
    "seed:worlds": "tsx scripts/seed-worlds.ts",
    "seed:variety": "tsx scripts/seed-variety-challenges.ts",
    "seed:achievements": "tsx scripts/seed-achievements.ts",
    "validate:beginner": "tsx scripts/validate-beginner-challenges.ts",
    "validate:variety": "tsx scripts/validate-variety-challenges.ts",
    "validate:variety:static": "tsx scripts/validate-variety-challenges.ts --static",
    "lint": "eslint src/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@code-to-escape/database": "workspace:*",
    "@code-to-escape/shared": "workspace:*",
    "@code-to-escape/types": "workspace:*",
    "@code-to-escape/utils": "workspace:*",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@code-to-escape/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  }
}
